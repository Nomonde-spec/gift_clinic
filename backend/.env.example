# Server configuration
PORT=5000
NODE_ENV=development

# Database connection (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:demo_password@ep-public-clinic-demo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT configuration
JWT_SECRET="clinic-system-super-secret-jwt-key-2025-production-grade"
JWT_EXPIRES_IN="24h"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"
